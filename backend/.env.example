# Environment variables for Mirage backend
# Copy this file to .env and fill in values before running

# Port the signaling server listens on
PORT=3001

# Optional: force the Wi-Fi/LAN address shown in the startup banner when this
# computer has Docker, VPN, Hyper-V, or other virtual network adapters.
# LAN_IP=192.168.1.42

# Comma-separated list of allowed CORS origins
# Use * for development; restrict in production
CORS_ORIGINS=*

# Maximum number of peers allowed to connect simultaneously
MAX_PEERS=50

# Socket.IO ping timeout (ms)
SOCKET_PING_TIMEOUT=20000
